---
import LivePreviewIsland from '../islands/LivePreviewIsland.tsx';

interface Props {
	url?: string;
	previewImage?: string;
	title: string;
	aspectRatio?: string;
}

const { url, previewImage, title, aspectRatio } = Astro.props;
---

<LivePreviewIsland
	client:visible
	url={url}
	previewImage={previewImage}
	title={title}
	aspectRatio={aspectRatio}
/>
