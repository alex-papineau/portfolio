---
import { Code } from 'astro:components';
import gameOfLifeCode from '../../scripts/portfolio/game-of-life.ts?raw';
---

<div class="gol-showcase-container mb-10 w-full rounded-[2px] border border-border bg-[#0c0c12] overflow-hidden">
	<!-- Top Bar -->
	<div class="flex items-center justify-between px-3 md:px-4 py-2.5 bg-[#141320] border-b border-border font-mono text-xs text-text-secondary select-none">
		<div class="flex items-center gap-2">
			<span class="text-accent uppercase tracking-[1px] font-bold">[ CONWAY.GOL ]</span>
			<span class="text-text-muted text-[11px] hidden sm:inline-block">— Cellular Automata Simulation</span>
		</div>
		<div class="font-mono text-xs text-text-muted tracking-[1px]">
			GEN: <span id="gen-count" class="text-accent font-bold">0</span>
		</div>
	</div>

	<!-- Canvas & Controls -->
	<div class="relative w-full flex flex-col items-center bg-black p-4 sm:p-6">
		<canvas 
			id="gol-canvas" 
			width="700" 
			height="400" 
			class="bg-black border border-border [image-rendering:pixelated] cursor-crosshair max-w-full rounded-[2px]"
		></canvas>

		<div class="flex gap-2 sm:gap-3 mt-5 flex-wrap justify-center font-mono">
			<button id="btn-play" class="bg-bg-subtle text-text-primary border border-border-light py-1.5 px-3.5 text-xs font-mono font-semibold uppercase tracking-[0.5px] cursor-pointer hover:border-accent hover:text-white active:scale-95 transition-all duration-150 rounded-xs">[ Play ]</button>
			<button id="btn-random" class="bg-bg-subtle text-text-primary border border-border-light py-1.5 px-3.5 text-xs font-mono font-semibold uppercase tracking-[0.5px] cursor-pointer hover:border-accent hover:text-white active:scale-95 transition-all duration-150 rounded-xs">[ Randomize ]</button>
			<button id="btn-clear" class="bg-bg-subtle text-text-primary border border-border-light py-1.5 px-3.5 text-xs font-mono font-semibold uppercase tracking-[0.5px] cursor-pointer hover:border-accent hover:text-white active:scale-95 transition-all duration-150 rounded-xs">[ Clear ]</button>
		</div>
	</div>

	<!-- Source Code Inspector -->
	<details class="group border-t border-border bg-[#090812] transition-colors">
		<summary class="flex items-center justify-between px-4 py-3 cursor-pointer select-none font-mono text-xs text-text-primary hover:text-accent hover:bg-accent/5 transition-colors">
			<div class="flex items-center gap-2">
				<span class="text-accent group-open:rotate-90 transition-transform duration-150 inline-block font-bold">▶</span>
				<span class="uppercase tracking-[1px] font-bold">[ SOURCE CODE: src/scripts/portfolio/game-of-life.ts ]</span>
			</div>
			<span class="text-text-secondary text-[11px] group-open:hidden">[ Expand Code ]</span>
			<span class="text-text-secondary text-[11px] hidden group-open:inline">[ Collapse Code ]</span>
		</summary>
		<div class="border-t border-border p-4 bg-[#050508] max-h-[460px] overflow-auto text-xs font-mono [&_pre]:!bg-transparent [&_pre]:!m-0 [&_pre]:!p-0">
			<Code code={gameOfLifeCode} lang="ts" theme="github-dark" />
		</div>
	</details>
</div>

<script src="../../scripts/portfolio/game-of-life.ts"></script>
