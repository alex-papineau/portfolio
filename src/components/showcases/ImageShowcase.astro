---
import { Image } from 'astro:assets';

interface Props {
	image?: string;
	title: string;
	caption?: string;
}

const { image, title, caption } = Astro.props;
---

{image && (
	<figure class="mb-10 w-full overflow-hidden rounded-xs border border-border bg-bg-subtle flex flex-col items-center justify-center p-4 md:p-8">
		<Image 
			src={image} 
			alt={`${title} preview`} 
			width={1200}
			height={675}
			class="max-w-full max-h-[480px] object-contain"
			loading="lazy"
		/>
		{caption && (
			<figcaption class="mt-3 font-mono text-xs text-text-muted tracking-[0.5px] text-center">
				{caption}
			</figcaption>
		)}
	</figure>
)}
