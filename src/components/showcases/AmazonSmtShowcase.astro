---
// AmazonSmtShowcase.astro
---

<div id="smt-showcase-root" class="smt-showcase-container mb-12 w-full rounded-xs border border-border bg-[#0c0c12] overflow-hidden font-mono text-text-primary">
  <!-- Top Bar -->
  <div class="flex items-center justify-between px-3 md:px-4 py-2.5 bg-[#141320] border-b border-border font-mono text-xs text-text-secondary select-none">
    <div class="flex items-center gap-2">
      <span class="text-accent uppercase tracking-[1px] font-bold">[ SMT.COMPANION ]</span>
      <span class="text-text-muted text-[11px] hidden sm:inline-block">— WebExtension MV3 Sandbox</span>
    </div>
    <div class="font-mono text-xs text-text-muted tracking-[1px]">
      STATUS: <span id="smt-status-text" class="text-accent font-bold">ONLINE</span>
    </div>
  </div>

  <!-- Browser Navigation Bar -->
  <div class="flex items-center justify-between gap-2.5 px-3 md:px-4 py-2 bg-[#100f1a] border-b border-border font-mono text-xs flex-wrap select-none">
    <!-- Tabs -->
    <div class="flex items-center gap-2">
      <button 
        id="tab-amazon" 
        class="bg-bg-subtle text-accent border border-accent py-1 px-3 text-xs font-mono font-semibold uppercase tracking-[0.5px] cursor-pointer rounded-xs active:scale-95 transition-all"
      >
        [ amazon.ca ]
      </button>

      <button 
        id="tab-wikipedia" 
        class="bg-bg-subtle text-text-muted border border-border-light py-1 px-3 text-xs font-mono font-semibold uppercase tracking-[0.5px] cursor-pointer hover:border-accent hover:text-white rounded-xs active:scale-95 transition-all"
      >
        [ wikipedia.org ]
      </button>

      <button 
        id="tab-google" 
        class="bg-bg-subtle text-text-muted border border-border-light py-1 px-3 text-xs font-mono font-semibold uppercase tracking-[0.5px] cursor-pointer hover:border-accent hover:text-white rounded-xs active:scale-95 transition-all"
      >
        [ google.com ]
      </button>
    </div>

    <!-- URL Bar -->
    <div class="flex-1 min-w-[200px] flex items-center px-3 py-1 bg-[#090812] border border-border rounded-xs text-text-secondary text-[11px] font-mono">
      <input 
        id="smt-url-display" 
        type="text" 
        readonly 
        value="https://www.amazon.ca" 
        class="w-full bg-transparent text-text-secondary outline-none font-mono text-xs select-all cursor-default" 
      />
    </div>

    <!-- SMT HUD Toggle Button -->
    <div class="relative">
      <button 
        id="btn-smt-popup" 
        class="bg-bg-subtle text-accent border border-border-light hover:border-accent hover:text-white py-1 px-3 text-xs font-mono font-semibold uppercase tracking-[0.5px] cursor-pointer rounded-xs active:scale-95 transition-all"
      >
        [ SMT HUD ]
      </button>

      <!-- Dropdown Popup Frame -->
      <div 
        id="smt-popup-container" 
        style="display: none;" 
        class="absolute right-0 top-10 z-50 w-[368px] h-[480px] bg-black border border-border rounded-xs shadow-2xl overflow-hidden"
      >
        <iframe 
          id="smt-popup-iframe" 
          src="/showcases/amazon-smt-companion/popup/popup.html" 
          class="w-full h-full border-0" 
          title="Amazon SMT Music Companion Extension Popup"
        ></iframe>
      </div>
    </div>
  </div>

  <!-- Browser Screen Area -->
  <div class="relative w-full p-6 sm:p-8 bg-black font-mono text-xs text-text-primary min-h-[300px] flex flex-col justify-between">
    <!-- Amazon Viewport -->
    <div id="viewport-amazon" class="space-y-4">
      <div class="flex items-center justify-between border-b border-border pb-3">
        <span class="text-accent font-bold tracking-[1px] uppercase">[ ACTIVE: AMAZON.CA ]</span>
        <span class="text-accent text-[11px] font-bold">[ TARGET MATCHED ]</span>
      </div>
      <div class="space-y-2 text-text-secondary">
        <div>Domain: <span class="text-white">amazon.ca</span></div>
        <div>Content Script: <span class="text-accent font-semibold">Active</span></div>
        <div>Playback Engine: <span class="text-accent font-semibold">Streaming</span></div>
        <div>In-Page Toast: <span class="text-white">Injected into bottom right of page</span></div>
      </div>
    </div>

    <!-- Wikipedia Viewport -->
    <div id="viewport-wikipedia" style="display: none;" class="space-y-4">
      <div class="flex items-center justify-between border-b border-border pb-3">
        <span class="text-text-muted font-bold tracking-[1px] uppercase">[ ACTIVE: WIKIPEDIA.ORG ]</span>
        <span class="text-text-muted text-[11px] font-bold">[ NO TARGET ]</span>
      </div>
      <div class="space-y-2 text-text-secondary">
        <div>Domain: <span class="text-text-muted">wikipedia.org</span></div>
        <div>Content Script: <span class="text-text-muted">Dormant</span></div>
        <div>Playback Engine: <span class="text-text-muted font-semibold">Paused (Non-Amazon Domain)</span></div>
        <div>Note: <span class="text-text-muted">Switch back to [ amazon.ca ] to resume audio.</span></div>
      </div>
    </div>

    <!-- Google Viewport -->
    <div id="viewport-google" style="display: none;" class="space-y-4">
      <div class="flex items-center justify-between border-b border-border pb-3">
        <span class="text-text-muted font-bold tracking-[1px] uppercase">[ ACTIVE: GOOGLE.COM ]</span>
        <span class="text-text-muted text-[11px] font-bold">[ NO TARGET ]</span>
      </div>
      <div class="space-y-2 text-text-secondary">
        <div>Domain: <span class="text-text-muted">google.com</span></div>
        <div>Content Script: <span class="text-text-muted">Dormant</span></div>
        <div>Playback Engine: <span class="text-text-muted font-semibold">Paused (Non-Amazon Domain)</span></div>
        <div>Note: <span class="text-text-muted">Switch back to [ amazon.ca ] to resume audio.</span></div>
      </div>
    </div>

    <!-- Bottom Status / Hint Bar -->
    <div class="pt-4 border-t border-border flex items-center justify-between text-[11px] text-text-muted flex-wrap gap-2">
      <span>Switch tabs above to test automatic playback and pausing. Click [ SMT HUD ] to open controls.</span>
      <span class="text-accent font-semibold">[ AUDIO READY ]</span>
    </div>
  </div>
</div>

<script>
  import { initAmazonSmtShowcase } from '../../scripts/portfolio/amazon-smt-showcase';
  initAmazonSmtShowcase();
</script>
