---
// AmazonSmtShowcase.astro
---

<div id="smt-showcase-root" class="smt-showcase-container mb-10 w-full rounded-[2px] border border-border bg-[#0c0c12] overflow-hidden font-mono">
  <!-- Top Bar / Window Controls -->
  <div class="flex items-center justify-between px-3 md:px-4 py-2 bg-[#141320] border-b border-border text-xs text-text-secondary select-none">
    <div class="flex items-center gap-2">
      <span class="inline-block w-2.5 h-2.5 rounded-full bg-red-500/80"></span>
      <span class="inline-block w-2.5 h-2.5 rounded-full bg-yellow-500/80"></span>
      <span class="inline-block w-2.5 h-2.5 rounded-full bg-green-500/80"></span>
      <span class="text-accent uppercase tracking-[1px] font-bold ml-2">[ SMT.MUSIC_COMPANION.EXE ]</span>
    </div>
    <div class="text-[11px] text-text-muted tracking-[0.5px]">
      WEBEXTENSION MV3 SANDBOX
    </div>
  </div>
</div>
