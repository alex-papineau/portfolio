---
import HeaderLink from './HeaderLink.astro';
import { SITE_TITLE } from '../consts';
import '../styles/components/Header.css';
---

<header>
	<nav>
		<div class="logo">
			<a href="/" class="logo-link">{SITE_TITLE}</a>
		</div>
		<button id="hamburger-menu" class="hamburger-menu" aria-label="Toggle navigation menu" aria-expanded="false">
			<span class="bar"></span>
			<span class="bar"></span>
			<span class="bar"></span>
		</button>
		<div id="internal-links" class="internal-links hidden-mobile">
			<HeaderLink href="/">Projects</HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>
			<HeaderLink href="/contact">Contact</HeaderLink>
		</div>
	</nav>
</header>
<script src="../scripts/header.ts"></script>
