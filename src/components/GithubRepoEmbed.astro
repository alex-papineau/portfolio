---
interface Props {
	repoName?: string;
	description?: string;
}

const { 
	repoName = "alex-papineau/lorem-ipsum-project", 
	description = "A dummy project simulating a repository view." 
} = Astro.props;

const files = [
	{ type: "folder", name: ".github/workflows", message: "Update CI pipeline", time: "2 weeks ago" },
	{ type: "folder", name: "public", message: "Add generic favicons", time: "1 month ago" },
	{ type: "folder", name: "src", message: "Refactor core components", time: "3 days ago" },
	{ type: "file", name: ".gitignore", message: "Initial commit", time: "2 months ago" },
	{ type: "file", name: "README.md", message: "Update documentation format", time: "5 hours ago" },
	{ type: "file", name: "package.json", message: "Bump dependencies", time: "1 week ago" }
];

const FolderIcon = `<svg aria-label="Directory" aria-hidden="true" height="16" viewBox="0 0 16 16" version="1.1" width="16" data-view-component="true" class="octicon fill-current"><path d="M1.75 1A1.75 1.75 0 0 0 0 2.75v10.5C0 14.216.784 15 1.75 15h12.5A1.75 1.75 0 0 0 16 13.25v-8.5A1.75 1.75 0 0 0 14.25 3H7.5a.25.25 0 0 1-.2-.1l-.9-1.2C6.07 1.26 5.55 1 5 1H1.75Z"></path></svg>`;
const FileIcon = `<svg aria-label="File" aria-hidden="true" height="16" viewBox="0 0 16 16" version="1.1" width="16" data-view-component="true" class="octicon fill-current"><path d="M2 1.75C2 .784 2.784 0 3.75 0h6.586c.464 0 .909.184 1.237.513l2.914 2.914c.329.328.513.773.513 1.237v9.586A1.75 1.75 0 0 1 13.25 16h-9.5A1.75 1.75 0 0 1 2 14.25Zm1.75-.25a.25.25 0 0 0-.25.25v12.5c0 .138.112.25.25.25h9.5a.25.25 0 0 0 .25-.25V4.664a.25.25 0 0 0-.073-.177l-2.914-2.914a.25.25 0 0 0-.177-.073H3.75Z"></path></svg>`;
---

<div class="border border-border rounded-md bg-bg-subtle text-text-secondary mb-8 overflow-hidden">
	<div class="p-4 border-b border-border bg-bg/50">
		<h3 class="m-0 text-xl flex items-center gap-2 text-accent font-mono font-bold">
			<svg aria-hidden="true" height="16" viewBox="0 0 16 16" version="1.1" width="16" class="fill-text-muted"><path d="M2 2.5A2.5 2.5 0 0 1 4.5 0h8.75a.75.75 0 0 1 .75.75v12.5a.75.75 0 0 1-.75.75h-2.5a.75.75 0 0 1 0-1.5h1.75v-2h-8a1 1 0 0 0-.714 1.7.75.75 0 1 1-1.072 1.05A2.495 2.495 0 0 1 2 11.5Zm10.5-1h-8a1 1 0 0 0-1 1v6.708A2.486 2.486 0 0 1 4.5 9h8ZM5 12.25a.25.25 0 0 1 .25-.25h3.5a.25.25 0 0 1 .25.25v3.25a.25.25 0 0 1-.4.214l-1.6-1.144-1.6 1.144a.25.25 0 0 1-.4-.214Z" fill="currentColor"></path></svg>
			{repoName}
			<span class="text-xs border border-border-light rounded-full py-0.5 px-2 text-text-muted ml-2 font-medium font-mono">Public</span>
		</h3>
	</div>

	<div class="p-4 flex items-center gap-4 text-sm font-mono flex-wrap">
		<button class="flex items-center gap-1.5 bg-bg-subtle border border-border text-text-primary py-1 px-3 rounded-md font-semibold cursor-pointer text-xs">
			<svg class="text-text-muted fill-current" aria-hidden="true" height="16" viewBox="0 0 16 16" version="1.1" width="16"><path d="M11.75 2.5a.75.75 0 1 0 0 1.5.75.75 0 0 0 0-1.5Zm-2.25.75a2.25 2.25 0 1 1 3 2.122V6A2.5 2.5 0 0 1 10 8.5H6a1 1 0 0 0-1 1v1.128a2.251 2.251 0 1 1-1.5 0V5.372a2.25 2.25 0 1 1 1.5 0v1.836A2.493 2.493 0 0 1 6 7h4a1 1 0 0 0 1-1v-.628A2.25 2.25 0 0 1 9.5 3.25ZM4.25 12a.75.75 0 1 0 0 1.5.75.75 0 0 0 0-1.5ZM3.5 3.25a.75.75 0 1 1 1.5 0 .75.75 0 0 1-1.5 0Z" fill="currentColor"></path></svg>
			main
		</button>
		<div class="flex-grow text-text-secondary">
			<strong class="text-text-primary">alex-papineau</strong> Update documentation format
		</div>
		<div class="text-text-muted text-xs">5 hours ago</div>
	</div>

	<div class="border border-border rounded-md mx-4 mb-4 overflow-hidden">
		<div class="flex items-center py-3 px-4 bg-bg border-b border-border text-sm font-mono text-text-muted">
			<div class="flex items-center gap-2 w-full md:w-1/4 font-medium text-text-primary">
				<div class="w-5 h-5 rounded-full bg-accent shrink-0"></div>
				<span class="truncate">alex-papineau</span>
			</div>
			<div class="hidden md:block w-[55%] text-text-secondary truncate">Merge pull request #42 from lorem-ipsum</div>
			<div class="hidden md:block w-[20%] text-right text-text-muted">5 hours ago</div>
		</div>

		<ul class="list-none p-0 m-0 font-mono">
			{files.map(file => (
				<li class="flex items-center py-2.5 px-4 border-b last:border-b-0 border-border text-sm hover:bg-white/5 transition-colors">
					<div class="w-full md:w-1/4 flex items-center gap-2.5 text-text-primary">
						<span class="flex items-center text-text-muted" set:html={file.type === "folder" ? FolderIcon : FileIcon} />
						<span class="truncate">{file.name}</span>
					</div>
					<div class="hidden md:block w-[55%] text-text-secondary truncate">{file.message}</div>
					<div class="hidden md:block w-[20%] text-right text-text-muted">{file.time}</div>
				</li>
			))}
		</ul>
	</div>

	<div class="border border-border rounded-md mx-4 mb-4 overflow-hidden">
		<div class="py-3 px-4 border-b border-border flex items-center gap-2 font-mono font-semibold bg-bg text-text-primary">
			<svg aria-hidden="true" height="16" viewBox="0 0 16 16" version="1.1" width="16" class="fill-current"><path d="M2 1.75C2 .784 2.784 0 3.75 0h8.5C13.216 0 14 .784 14 1.75v12.5A1.75 1.75 0 0 1 12.25 16h-8.5A1.75 1.75 0 0 1 2 14.25Zm1.75-.25a.25.25 0 0 0-.25.25v12.5c0 .138.112.25.25.25h8.5a.25.25 0 0 0 .25-.25V1.75a.25.25 0 0 0-.25-.25Zm6.75 4.75a.75.75 0 0 0 0-1.5h-5a.75.75 0 0 0 0 1.5Z" fill="currentColor"></path></svg>
			<span>README.md</span>
		</div>
		<div class="p-6 md:p-8 bg-bg-subtle/30 text-text-secondary">
			<h1 class="pb-2 border-b border-border mt-0 text-xl font-mono text-text-primary">{repoName.split("/").pop()}</h1>
			<p>{description}</p>
			<p>Lorem ipsum dolor sit amet, consectetur adipiscing elit. Tincidunt hendrerit pellentesque amet nunc cursus tristique accumsan facilisi. Cras at semper purus duis tellus.</p>
			<h2 class="text-lg font-mono text-text-primary mt-6 mb-2">Installation</h2>
			<pre class="bg-bg border border-border p-4 rounded-md my-4 font-mono text-sm overflow-x-auto"><code>npm install
npm run start</code></pre>
			<h2 class="text-lg font-mono text-text-primary mt-6 mb-2">Usage</h2>
			<p>Vestibulum ante ipsum primis in faucibus orci luctus et ultrices posuere cubilia curae; Sed diam mi, elementum et facilisis ut, imperdiet eu ex.</p>
		</div>
	</div>
</div>
