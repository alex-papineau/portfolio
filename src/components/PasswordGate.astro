---
// PasswordGate.astro
import '../styles/password-gate.css';
---

<div id="password-gate" class="password-gate">
  <div class="crt-overlay"></div>
  
  <div class="eyes-container" id="eyes-container">
    <!-- Small eyes injected via JS -->
  </div>

  <div class="center-content">
    <div class="large-eye-container" id="large-eye">
      <div class="large-eye-pupil">(O)</div>
    </div>

    <form id="password-form" class="password-form">
      <label for="gate-password">ENTER PASSWORD:</label>
      <input type="password" id="gate-password" autofocus />
      <button type="submit">ACCESS</button>
      <div id="password-error" class="error-msg"></div>
    </form>
  </div>
</div>

<script src="../scripts/password-gate.ts"></script>
