---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import '../styles/pages/home.css';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		
		<Header />
		<main>
			<p>hello</p>
		</main>

		<section class="project-grid">
			<a href="/portfolio/cool-app" class="project-card">
				<h3>cool-app</h3>
				<p>Cool App project.</p>
			</a>
			<a href="/portfolio/albanian-virus" class="project-card">
				<h3>albanian-virus</h3>
				<p>Albanian virus project.</p>
			</a>
			<a href="/portfolio/amazon-smt-music-companion" class="project-card">
				<h3>amazon-smt-music-companion</h3>
				<p>Amazon SMT music companion project.</p>
			</a>

			<a href="/portfolio/chrome-dino-game" class="project-card">
				<h3>chrome-dino-game</h3>
				<p>Chrome dino game clone.</p>
			</a>
			<a href="/portfolio/firefox-ui-tweaks" class="project-card">
				<h3>firefox-ui-tweaks</h3>
				<p>Firefox UI tweaks.</p>
			</a>
			<a href="/portfolio/sadie-portfolio" class="project-card">
				<h3>sadie-portfolio</h3>
				<p>Sadie's portfolio.</p>
			</a>
			<a href="/portfolio/terminal-site" class="project-card">
				<h3>terminal-site</h3>
				<p>Terminal-based website.</p>
			</a>
			<a href="/portfolio/twitter-turn-based-post-theme-plugin" class="project-card">
				<h3>twitter-turn-based-post-theme-plugin</h3>
				<p>Twitter turn-based post theme plugin.</p>
			</a>
			<a href="/portfolio/virtual-ant-farm" class="project-card">
				<h3>virtual-ant-farm</h3>
				<p>Virtual ant farm simulation.</p>
			</a>
			<a href="/portfolio/map-stuff" class="project-card">
				<h3>map-stuff</h3>
				<p>Geographic data points.</p>
			</a>
			<a href="/portfolio/game-of-life" class="project-card">
				<h3>game-of-life</h3>
