---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';

const allProjects = await getCollection('projects');

const professionalProjects = allProjects
	.filter((p) => p.data.category === 'professional')
	.sort((a, b) => a.data.order - b.data.order);

const funProjects = allProjects
	.filter((p) => p.data.category === 'fun')
	.sort((a, b) => a.data.order - b.data.order);

const totalCount = allProjects.length;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body class="bg-bg text-text-secondary min-h-screen flex flex-col">
		<!-- Hero & Top Controls Section -->
		<section class="max-w-[900px] w-full mx-auto pt-16 pb-8 px-4 md:px-6">
			<div class="mb-5">
				<img src="/favicon.svg" alt="Site Logo" class="w-10 h-10" />
			</div>
			<div class="font-mono text-xs text-text-muted uppercase tracking-[2px] mb-2">[ WEB PROGRAMMER ]</div>
			<h1 class="text-4xl md:text-5xl font-bold font-mono text-text-primary mb-3 tracking-tight leading-tight">{SITE_TITLE}</h1>
			<p class="text-base md:text-lg leading-relaxed text-text-secondary max-w-[720px] mb-7">
				This site is a small collection of my professional and personal projects, experiments, and other work. You can filter the projects by category or search for specific keywords in the titles, descriptions, or tags. View the project details for this portfolio on its on page <a href="/portfolio/portfolio" class="text-accent hover:underline">here</a>.
			</p>
			<p class="text-base md:text-lg leading-relaxed text-text-secondary max-w-[720px] mb-7">
				Feel free to reach out to me via email or check out my GitHub profile.
			</p>
			<div class="flex gap-4 flex-wrap mb-8">
				<a href="mailto:alex.papineau02@gmail.com" class="bg-bg-subtle border border-border p-4 md:p-5 rounded-xs no-underline text-text-primary font-mono flex flex-col gap-1.5 flex-1 min-w-[220px] hover:border-accent hover:bg-accent/5 transition-all duration-150">
					<span class="text-text-muted text-xs uppercase tracking-[1px]">[ EMAIL ]</span>
					<span class="text-sm md:text-base font-bold text-accent">alex.papineau02@gmail.com ↗</span>
				</a>
				<a href="https://github.com/alex-papineau" target="_blank" rel="noopener noreferrer" class="bg-bg-subtle border border-border p-4 md:p-5 rounded-xs no-underline text-text-primary font-mono flex flex-col gap-1.5 flex-1 min-w-[220px] hover:border-accent hover:bg-accent/5 transition-all duration-150">
					<span class="text-text-muted text-xs uppercase tracking-[1px]">[ GITHUB ]</span>
					<span class="text-sm md:text-base font-bold text-accent">@alex-papineau ↗</span>
				</a>
			</div>

			<!-- Search & Filter Controls -->
			<div class="mt-6 pt-6 border-t border-dashed border-border">
				<input 
					type="search" 
					id="project-search" 
					class="w-full py-3.5 px-5 bg-bg-subtle border border-border rounded-xs text-text-primary font-mono text-base focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent placeholder:text-text-muted placeholder:text-sm transition-all duration-150" 
					placeholder="Search all projects, tags, or tools (e.g. Canvas, TypeScript)..." 
					aria-label="Search projects"
				/>

				<div class="flex gap-2 flex-wrap items-center mt-4" id="category-filters">
					<button class="filter-btn active bg-transparent text-text-muted border border-border rounded-xs py-1.5 px-3.5 font-mono text-xs uppercase tracking-[0.5px] cursor-pointer hover:text-text-primary hover:border-border-light transition-all duration-150 [&.active]:text-accent [&.active]:border-accent [&.active]:bg-accent/10 [&.active]:font-bold" data-filter="all">All [{totalCount}]</button>
					<button class="filter-btn bg-transparent text-text-muted border border-border rounded-xs py-1.5 px-3.5 font-mono text-xs uppercase tracking-[0.5px] cursor-pointer hover:text-text-primary hover:border-border-light transition-all duration-150 [&.active]:text-accent [&.active]:border-accent [&.active]:bg-accent/10 [&.active]:font-bold" data-filter="professional">Professional [{professionalProjects.length}]</button>
					<button class="filter-btn bg-transparent text-text-muted border border-border rounded-xs py-1.5 px-3.5 font-mono text-xs uppercase tracking-[0.5px] cursor-pointer hover:text-text-primary hover:border-border-light transition-all duration-150 [&.active]:text-accent [&.active]:border-accent [&.active]:bg-accent/10 [&.active]:font-bold" data-filter="fun">For Fun [{funProjects.length}]</button>
				</div>
			</div>
		</section>

		<!-- SECTION 01: PROFESSIONAL WORK -->
		<section class="project-section w-full" id="section-professional" data-section-category="professional">
			<div class="w-full bg-[#090812] border-t border-b border-border border-l-[3px] border-l-accent py-4 px-4 md:px-8 flex items-center justify-between mt-8 font-mono">
				<h2 class="text-sm uppercase tracking-[2px] text-text-primary font-bold m-0 flex items-center gap-3">
					<span>PROFESSIONAL WORK</span>
				</h2>
				<span class="text-xs text-accent tracking-[1px]" id="count-professional">[{professionalProjects.length} PROJECT]</span>
			</div>

			<div class="flex flex-col w-full border-b border-border overflow-x-hidden">
				{professionalProjects.map((project) => (
					<a 
						href={`/portfolio/${project.id}`} 
						class="project-card group bg-bg border-b border-border p-6 md:p-8 flex flex-col md:flex-row items-stretch md:items-center gap-6 md:gap-10 no-underline hover:bg-[#0b0916] hover:border-border-light transition-all duration-150 relative" 
						data-category="professional"
						data-title={project.data.title.toLowerCase()}
						data-description={project.data.description.toLowerCase()}
						data-tags={(project.data.tags || []).join(' ').toLowerCase()}
					>
						{project.data.heroImage && (
							<div class="w-full md:w-[380px] lg:w-[420px] aspect-video shrink-0 overflow-hidden rounded-xs border border-border bg-bg-subtle relative flex items-center justify-center p-6">
								<img 
									src={project.data.heroImage} 
									alt={`${project.data.title} preview`} 
									class="max-w-full max-h-full object-contain group-hover:scale-105 transition-transform duration-300 ease-out"
									loading="lazy"
								/>
							</div>
						)}
						<div class="flex-1 flex flex-col justify-between self-stretch min-w-0">
							<div>
								<div class="font-mono text-[0.7rem] uppercase tracking-[1px] mb-2 text-accent">[PROFESSIONAL]</div>
								<h3 class="m-0 mb-2 text-xl md:text-2xl font-mono text-text-primary uppercase tracking-[0.5px] group-hover:text-accent transition-colors duration-150">{project.data.title}</h3>
								<p class="m-0 text-sm md:text-base text-text-secondary leading-relaxed">{project.data.description}</p>
							</div>
							<div class="flex justify-between items-center mt-6 pt-3.5 border-t border-dashed border-border">
								<div class="flex flex-wrap gap-1.5">
									{project.data.tags?.map((tag) => (
										<span class="font-mono text-[0.72rem] text-text-muted border border-border py-0.5 px-1.5 rounded-xs uppercase">{tag}</span>
									))}
								</div>
								<span class="font-mono text-base text-text-muted group-hover:text-accent group-hover:translate-x-1 transition-all duration-150">→</span>
							</div>
						</div>
					</a>
				))}
			</div>
		</section>

		<!-- SECTION 02: EXPERIMENTS & FOR FUN -->
		<section class="project-section w-full" id="section-fun" data-section-category="fun">
			<div class="w-full bg-bg-subtle border-t border-b border-border py-4 px-4 md:px-8 flex items-center justify-between mt-8 font-mono">
				<h2 class="text-sm uppercase tracking-[2px] text-text-primary font-bold m-0 flex items-center gap-3">
					<span>EXPERIMENTS & FOR FUN</span>
				</h2>
				<span class="text-xs text-accent tracking-[1px]" id="count-fun">[{funProjects.length} PROJECTS]</span>
			</div>

			<div class="grid grid-cols-1 md:grid-cols-[repeat(auto-fit,minmax(360px,1fr))] w-full border-b border-border overflow-x-hidden">
				{funProjects.map((project) => (
					<a 
						href={`/portfolio/${project.id}`} 
						class="project-card group bg-bg border-b md:border-r border-border p-6 md:p-10 flex flex-col justify-between no-underline min-h-[240px] hover:bg-bg-subtle hover:border-border-light transition-colors duration-150 relative" 
						data-category="fun"
						data-title={project.data.title.toLowerCase()}
						data-description={project.data.description.toLowerCase()}
						data-tags={(project.data.tags || []).join(' ').toLowerCase()}
					>
						<div class="mb-5">
							<div class="font-mono text-[0.7rem] uppercase tracking-[1px] mb-2 text-text-muted">[FOR FUN]</div>
							<h3 class="m-0 mb-2 text-xl font-mono text-text-primary uppercase tracking-[0.5px] group-hover:text-accent transition-colors duration-150">{project.data.title}</h3>
							<p class="m-0 text-sm text-text-secondary leading-relaxed">{project.data.description}</p>
						</div>
						<div class="flex justify-between items-center mt-6 pt-3.5 border-t border-dashed border-border">
							<div class="flex flex-wrap gap-1.5">
								{project.data.tags?.map((tag) => (
									<span class="font-mono text-[0.72rem] text-text-muted border border-border py-0.5 px-1.5 rounded-xs uppercase">{tag}</span>
								))}
							</div>
							<span class="font-mono text-base text-text-muted group-hover:text-accent group-hover:translate-x-1 transition-all duration-150">→</span>
						</div>
					</a>
				))}
			</div>
		</section>

		<div id="empty-state" class="py-16 px-6 text-center font-mono text-text-muted text-sm border-b border-dashed border-border mx-auto max-w-[900px] w-full" style="display: none;">
			No projects found matching the filter query.
		</div>

		<div class="mt-auto">
			<Footer />
		</div>

		<script>
			function initGridFilter() {
				const searchInput = document.getElementById('project-search') as HTMLInputElement | null;
				const filterButtons = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
				const sections = document.querySelectorAll<HTMLElement>('.project-section');
				const emptyState = document.getElementById('empty-state');

				let activeCategory = 'all';
				let searchQuery = '';

				function applyFilters() {
					let totalVisible = 0;

					sections.forEach((section) => {
						const sectionCategory = section.getAttribute('data-section-category') || '';
						const cards = section.querySelectorAll<HTMLElement>('.project-card');
						let sectionVisibleCount = 0;

						const categoryAllowed = activeCategory === 'all' || activeCategory === sectionCategory;

						if (!categoryAllowed) {
							section.classList.add('hidden');
							cards.forEach(c => c.classList.add('hidden'));
							return;
						}

						cards.forEach((card) => {
							const title = card.getAttribute('data-title') || '';
							const desc = card.getAttribute('data-description') || '';
							const tags = card.getAttribute('data-tags') || '';
							const text = card.textContent?.toLowerCase() || '';

							const matchesSearch = !searchQuery || 
								title.includes(searchQuery) || 
								desc.includes(searchQuery) || 
								tags.includes(searchQuery) || 
								text.includes(searchQuery);

							if (matchesSearch) {
								card.classList.remove('hidden');
								sectionVisibleCount++;
								totalVisible++;
							} else {
								card.classList.add('hidden');
							}
						});

						if (sectionVisibleCount === 0) {
							section.classList.add('hidden');
						} else {
							section.classList.remove('hidden');
						}
					});

					if (emptyState) {
						emptyState.style.display = totalVisible === 0 ? 'block' : 'none';
					}
				}

				if (searchInput) {
					searchInput.addEventListener('input', (e) => {
						searchQuery = (e.target as HTMLInputElement).value.trim().toLowerCase();
						applyFilters();
					});
				}

				filterButtons.forEach((btn) => {
					btn.addEventListener('click', () => {
						filterButtons.forEach((b) => b.classList.remove('active'));
						btn.classList.add('active');
						activeCategory = btn.getAttribute('data-filter') || 'all';
						applyFilters();
					});
				});
			}

			document.addEventListener('astro:page-load', initGridFilter);
			if (document.readyState === 'complete' || document.readyState === 'interactive') {
				initGridFilter();
			} else {
				document.addEventListener('DOMContentLoaded', initGridFilter);
			}
		</script>
	</body>
</html>
