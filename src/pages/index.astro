---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import '../styles/pages/home.css';

const allProjects = await getCollection('projects');

const professionalProjects = allProjects
	.filter((p) => p.data.category === 'professional')
	.sort((a, b) => a.data.order - b.data.order);

const funProjects = allProjects
	.filter((p) => p.data.category === 'fun')
	.sort((a, b) => a.data.order - b.data.order);

const totalCount = allProjects.length;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		
		<!-- Hero & Top Controls Section -->
		<section class="hero-wrapper">
			<div class="hero-meta">[ WEB DEVELOPER ]</div>
			<h1 class="hero-title">Alex Papineau</h1>
			<p class="hero-bio">
				Web developer building modern websites, performant web applications, and interactive digital experiments. Focused on minimalism, speed, and clean wireframe UX.
			</p>
			<div class="hero-links">
				<a href="/about" class="wireframe-btn">About</a>
				<a href="/contact" class="wireframe-btn">Contact</a>
				<a href="https://github.com/alex-papineau" target="_blank" rel="noopener noreferrer" class="wireframe-btn">GitHub ↗</a>
			</div>

			<!-- Search & Filter Controls -->
			<div class="controls-container">
				<input 
					type="search" 
					id="project-search" 
					class="search-input" 
					placeholder="Search all projects, tags, or tools (e.g. Canvas, TypeScript)..." 
					aria-label="Search projects"
				/>

				<div class="filter-bar" id="category-filters">
					<button class="filter-btn active" data-filter="all">All [{totalCount}]</button>
					<button class="filter-btn" data-filter="professional">Professional [{professionalProjects.length}]</button>
					<button class="filter-btn" data-filter="fun">For Fun [{funProjects.length}]</button>
				</div>
			</div>
		</section>

		<!-- SECTION 01: PROFESSIONAL WORK -->
		<section class="project-section" id="section-professional" data-section-category="professional">
			<div class="section-banner professional">
				<h2 class="section-banner-title">
					<span>// 01. PROFESSIONAL WORK</span>
				</h2>
				<span class="section-banner-count" id="count-professional">[{professionalProjects.length} PROJECT]</span>
			</div>

			<div class="full-project-grid">
				{professionalProjects.map((project) => (
					<a 
						href={`/portfolio/${project.id}`} 
						class="project-card professional" 
						data-category="professional"
						data-title={project.data.title.toLowerCase()}
						data-description={project.data.description.toLowerCase()}
						data-tags={(project.data.tags || []).join(' ').toLowerCase()}
					>
						<div class="card-top">
							<div class="card-category-indicator professional">[PROFESSIONAL]</div>
							<h3 class="project-title">{project.data.title}</h3>
							<p class="project-desc">{project.data.description}</p>
						</div>
						<div class="card-footer">
							<div class="card-tags">
								{project.data.tags?.map((tag) => (
									<span class="tag-badge">{tag}</span>
								))}
							</div>
							<span class="card-arrow">→</span>
						</div>
					</a>
				))}
			</div>
		</section>

		<!-- SECTION 02: EXPERIMENTS & FOR FUN -->
		<section class="project-section" id="section-fun" data-section-category="fun">
			<div class="section-banner">
				<h2 class="section-banner-title">
					<span>// 02. EXPERIMENTS & FOR FUN</span>
				</h2>
				<span class="section-banner-count" id="count-fun">[{funProjects.length} PROJECTS]</span>
			</div>

			<div class="full-project-grid">
				{funProjects.map((project) => (
					<a 
						href={`/portfolio/${project.id}`} 
						class="project-card" 
						data-category="fun"
						data-title={project.data.title.toLowerCase()}
						data-description={project.data.description.toLowerCase()}
						data-tags={(project.data.tags || []).join(' ').toLowerCase()}
					>
						<div class="card-top">
							<div class="card-category-indicator">[FOR FUN]</div>
							<h3 class="project-title">{project.data.title}</h3>
							<p class="project-desc">{project.data.description}</p>
						</div>
						<div class="card-footer">
							<div class="card-tags">
								{project.data.tags?.map((tag) => (
									<span class="tag-badge">{tag}</span>
								))}
							</div>
							<span class="card-arrow">→</span>
						</div>
					</a>
				))}
			</div>
		</section>

		<div id="empty-state" class="empty-state" style="display: none;">
			No projects found matching the filter query.
		</div>

		<Footer />

		<script>
			function initGridFilter() {
				const searchInput = document.getElementById('project-search') as HTMLInputElement | null;
				const filterButtons = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
				const sections = document.querySelectorAll<HTMLElement>('.project-section');
				const emptyState = document.getElementById('empty-state');

				let activeCategory = 'all';
				let searchQuery = '';

				function applyFilters() {
					let totalVisible = 0;

					sections.forEach((section) => {
						const sectionCategory = section.getAttribute('data-section-category') || '';
						const cards = section.querySelectorAll<HTMLElement>('.project-card');
						let sectionVisibleCount = 0;

						const categoryAllowed = activeCategory === 'all' || activeCategory === sectionCategory;

						if (!categoryAllowed) {
							section.classList.add('hidden');
							cards.forEach(c => c.classList.add('hidden'));
							return;
						}

						cards.forEach((card) => {
							const title = card.getAttribute('data-title') || '';
							const desc = card.getAttribute('data-description') || '';
							const tags = card.getAttribute('data-tags') || '';
							const text = card.textContent?.toLowerCase() || '';

							const matchesSearch = !searchQuery || 
								title.includes(searchQuery) || 
								desc.includes(searchQuery) || 
								tags.includes(searchQuery) || 
								text.includes(searchQuery);

							if (matchesSearch) {
								card.classList.remove('hidden');
								sectionVisibleCount++;
								totalVisible++;
							} else {
								card.classList.add('hidden');
							}
						});

						if (sectionVisibleCount === 0) {
							section.classList.add('hidden');
						} else {
							section.classList.remove('hidden');
						}
					});

					if (emptyState) {
						emptyState.style.display = totalVisible === 0 ? 'block' : 'none';
					}
				}

				if (searchInput) {
					searchInput.addEventListener('input', (e) => {
						searchQuery = (e.target as HTMLInputElement).value.trim().toLowerCase();
						applyFilters();
					});
				}

				filterButtons.forEach((btn) => {
					btn.addEventListener('click', () => {
						filterButtons.forEach((b) => b.classList.remove('active'));
						btn.classList.add('active');
						activeCategory = btn.getAttribute('data-filter') || 'all';
						applyFilters();
					});
				});
			}

			document.addEventListener('astro:page-load', initGridFilter);
			if (document.readyState === 'complete' || document.readyState === 'interactive') {
				initGridFilter();
			} else {
				document.addEventListener('DOMContentLoaded', initGridFilter);
			}
		</script>
	</body>
</html>
