---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PasswordGate from '../components/PasswordGate.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<PasswordGate />
		<Header />
		<main>
			<h1>SYSTEM.ACCESS.GRANTED</h1>
			<p>
				Welcome to the terminal node of <strong>Alex Papineau</strong>.
				This digital space serves as a portfolio and archive of ongoing technical operations, experiments, and captured media.
			</p>
			<p>
				Navigate through the system using the upper header protocol. Visual data streams are archived in the Photo section, while textual transmissions exist in the Blog.
			</p>
			<p>
				Available directories:
			</p>
			<ul>
				<li>[<code>/blog</code>] - Developer logs and transmissions.</li>
				<li>[<code>/about</code>] - System metadata and operator skills.</li>
				<li>[<code>/map-stuff</code>] - Geographic data points.</li>
			</ul>
			<p>
				Awaiting command input...
			</p>
		</main>
		<Footer />
	</body>
</html>
