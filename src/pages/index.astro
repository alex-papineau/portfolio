	</head>
	<body>
		<PasswordGate />
		<Header />
		<main>
			<p>hello</p>
		</main>

		<section class="project-grid">
			<a href="/portfolio/lorem-ipsum" class="project-card">
				<h3>lorem-ipsum-project</h3>
				<p>A generic data processor module (Dummy Data).</p>
			</a>
			<a href="/portfolio/game-of-life" class="project-card">
				<h3>conway-game-of-life</h3>
				<p>Cellular automata simulation.</p>
			</a>
			<a href="/portfolio/map-stuff" class="project-card">
				<h3>map-stuff</h3>
				<p>Geographic data points.</p>
			</a>
			<a href="/portfolio/secure-terminal-interface" class="project-card">
				<h3>secure-terminal-interface</h3>
				<p>[REDACTED] Pending final commit.</p>
