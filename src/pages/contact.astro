---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Contact | ${SITE_TITLE}`} description="Get in touch with Alex Papineau." />
	</head>
	<body class="bg-bg text-text-secondary min-h-screen flex flex-col">
		<Header />
		<main class="max-w-[840px] w-[calc(100%-2rem)] mx-auto py-10 px-4 flex-1">
			<h1 class="text-3xl md:text-4xl font-bold font-mono text-text-primary mb-2">Contact</h1>
			<p class="text-text-secondary mb-8 leading-relaxed">
				Have a question, project proposal, or inquiry? Reach out directly.
			</p>

			<div class="flex gap-4 flex-wrap my-8">
				<a href="mailto:alex@alexpapineau.com" class="bg-bg-subtle border border-border p-5 rounded-[2px] no-underline text-text-primary font-mono flex flex-col gap-1.5 flex-1 min-w-[220px] hover:border-accent hover:bg-accent/5 transition-all duration-150">
					<span class="text-text-muted text-xs uppercase tracking-[1px]">[ EMAIL ]</span>
					<span class="text-sm md:text-base font-bold text-accent">alex@alexpapineau.com ↗</span>
				</a>
				<a href="https://github.com/alex-papineau" target="_blank" rel="noopener noreferrer" class="bg-bg-subtle border border-border p-5 rounded-[2px] no-underline text-text-primary font-mono flex flex-col gap-1.5 flex-1 min-w-[220px] hover:border-accent hover:bg-accent/5 transition-all duration-150">
					<span class="text-text-muted text-xs uppercase tracking-[1px]">[ GITHUB ]</span>
					<span class="text-sm md:text-base font-bold text-accent">@alex-papineau ↗</span>
				</a>
			</div>
			
			<div class="my-8 max-w-[600px]">
				<h2 class="text-2xl font-mono font-bold text-text-primary mb-4">Send a Message</h2>
				<form action="mailto:alex@alexpapineau.com" method="GET" enctype="text/plain" class="flex flex-col gap-6">
					<div class="flex flex-col gap-2">
						<label for="name" class="font-semibold text-text-primary font-mono text-sm">Name</label>
						<input type="text" id="name" name="name" required placeholder="Your name" class="p-3.5 text-base border border-border rounded-[2px] bg-bg-subtle text-text-primary font-mono focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent transition-colors" />
					</div>
					
					<div class="flex flex-col gap-2">
						<label for="subject" class="font-semibold text-text-primary font-mono text-sm">Subject</label>
						<input type="text" id="subject" name="subject" required placeholder="Project Inquiry / Collaboration" class="p-3.5 text-base border border-border rounded-[2px] bg-bg-subtle text-text-primary font-mono focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent transition-colors" />
					</div>
					
					<div class="flex flex-col gap-2">
						<label for="body" class="font-semibold text-text-primary font-mono text-sm">Message</label>
						<textarea id="body" name="body" rows={5} required placeholder="Tell me about your project..." class="p-3.5 text-base border border-border rounded-[2px] bg-bg-subtle text-text-primary font-mono focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent transition-colors"></textarea>
					</div>
					
					<button type="submit" class="py-2.5 px-5 bg-transparent text-accent border border-accent rounded-[2px] font-mono text-sm uppercase tracking-[0.5px] cursor-pointer hover:bg-accent hover:text-black transition-all duration-150 self-start">Send Message →</button>
				</form>
			</div>
		</main>
		<Footer />
	</body>
</html>
