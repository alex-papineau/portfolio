---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

import { SITE_TITLE } from '../consts';
import '../styles/pages/contact.css';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Contact | ${SITE_TITLE}`} description="Get in touch with Alex Papineau." />
		<style>
			.contact-links {
				display: flex;
				gap: 1rem;
				flex-wrap: wrap;
				margin: 2rem 0;
			}
			.contact-card {
				background: var(--bg-subtle, #080808);
				border: 1px solid var(--border, #262626);
				padding: 1.25rem 1.5rem;
				border-radius: 2px;
				text-decoration: none;
				color: var(--text-primary, #ffffff);
				font-family: var(--font-mono, monospace);
				display: flex;
				flex-direction: column;
				gap: 0.35rem;
				flex: 1;
				min-width: 220px;
				transition: border-color 0.15s ease, background-color 0.15s ease;
			}
			.contact-card:hover {
				border-color: var(--accent, #7b68ee);
				background-color: rgba(123, 104, 238, 0.05);
			}
			.contact-card span.label {
				color: var(--text-muted, #737373);
				font-size: 0.75rem;
				text-transform: uppercase;
				letter-spacing: 1px;
			}
			.contact-card span.value {
				font-size: 0.95rem;
				font-weight: 700;
				color: var(--accent, #7b68ee);
			}
			.submit-btn {
				padding: 0.6rem 1.25rem;
				background: transparent;
				color: var(--accent, #7b68ee);
				border: 1px solid var(--accent, #7b68ee);
				border-radius: 2px;
				font-family: var(--font-mono, monospace);
				font-size: 0.85rem;
				text-transform: uppercase;
				letter-spacing: 0.5px;
				cursor: pointer;
				transition: all 0.15s ease;
			}
			.submit-btn:hover {
				background: var(--accent, #7b68ee);
				color: #000000;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<h1>Contact</h1>
			<p style="color: var(--text-secondary); margin-bottom: 2rem;">
				Have a question, project proposal, or inquiry? Reach out directly.
			</p>

			<div class="contact-links">
				<a href="mailto:alex@alexpapineau.com" class="contact-card">
					<span class="label">[ EMAIL ]</span>
					<span class="value">alex@alexpapineau.com ↗</span>
				</a>
				<a href="https://github.com/alex-papineau" target="_blank" rel="noopener noreferrer" class="contact-card">
					<span class="label">[ GITHUB ]</span>
					<span class="value">@alex-papineau ↗</span>
				</a>
			</div>
			
			<div class="contact-form-container">
				<h2>Send a Message</h2>
				<form action="mailto:alex@alexpapineau.com" method="GET" enctype="text/plain" class="contact-form">
					<div class="form-group">
						<label for="name">Name</label>
						<input type="text" id="name" name="name" required placeholder="Your name" />
					</div>
					
					<div class="form-group">
						<label for="subject">Subject</label>
						<input type="text" id="subject" name="subject" required placeholder="Project Inquiry / Collaboration" />
					</div>
					
					<div class="form-group">
						<label for="body">Message</label>
						<textarea id="body" name="body" rows="5" required placeholder="Tell me about your project..."></textarea>
					</div>
					
					<button type="submit" class="submit-btn">Send Message →</button>
				</form>
			</div>
		</main>
		<Footer />
	</body>
</html>
