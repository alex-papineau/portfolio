---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { SITE_TITLE } from '../../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Map Explorer | ${SITE_TITLE}`} description="Interactive Leaflet geospatial mapping visualization." />
		<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" crossorigin="" />
		<script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" crossorigin=""></script>
	</head>
	<body class="bg-bg text-text-secondary min-h-screen flex flex-col">
		<Header />
		<main class="max-w-[840px] w-[calc(100%-2rem)] mx-auto py-10 px-4 flex-1">
			<a href="/" class="inline-block mb-6 text-text-muted font-mono text-sm uppercase tracking-[0.5px] no-underline hover:text-accent transition-colors duration-150">← All Projects</a>
			<div>
				<span class="inline-block font-mono text-xs uppercase tracking-[1px] py-1 px-2 border border-border rounded-[2px] mb-3 text-text-muted">[FOR FUN]</span>
			</div>
			<h1 class="text-3xl md:text-4xl font-bold font-mono text-text-primary mb-2">Map Explorer</h1>
			<p class="text-text-secondary leading-relaxed mb-6">
				Interactive geospatial mapping and visualization using Leaflet.js with dark-mode tile layers.
			</p>

			<div id="map-container" class="w-full h-[520px] rounded-[2px] border border-border my-6"></div>

			<script is:inline>
				document.addEventListener('DOMContentLoaded', () => {
					if (typeof L !== 'undefined' && document.getElementById('map-container')) {
						const map = L.map('map-container').setView([40.7128, -74.0060], 12);
						L.tileLayer('https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png', {
							attribution: '&copy; <a href="https://carto.com/">CARTO</a>',
							subdomains: 'abcd',
							maxZoom: 19
						}).addTo(map);

						L.marker([40.7128, -74.0060]).addTo(map)
							.bindPopup('<b>New York City</b><br>Interactive Geospatial Marker.')
							.openPopup();
					}
				});
			</script>
		</main>
		<Footer />
	</body>
</html>
