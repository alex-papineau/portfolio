---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PasswordGate from '../../components/PasswordGate.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../../consts';
import '../../styles/pages/home.css'; // reuse project-grid layout
import '../../styles/pages/portfolio-index.css';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Portfolio | ${SITE_TITLE}`} description="A collection of my portfolio projects." />
	</head>
	<body>
		<PasswordGate />
		<Header />
		<main>
			<h1>Portfolio</h1>
			<p>A full index of projects and experiments.</p>
			
			<div class="search-container">
				<input 
					type="search" 
					id="portfolio-search" 
					class="search-input" 
					placeholder="Search projects by name or description..." 
					aria-label="Search portfolio projects"
				/>
			</div>
		</main>

		<section class="project-grid" id="portfolio-grid">
			<a href="/portfolio/cool-app" class="project-card" data-title="cool-app cool app project">
				<h3>cool-app</h3>
				<p>Cool App project.</p>
			</a>
			<a href="/portfolio/albanian-virus" class="project-card" data-title="albanian-virus albanian virus project">
				<h3>albanian-virus</h3>
				<p>Albanian virus project.</p>
			</a>
			<a href="/portfolio/amazon-smt-music-companion" class="project-card" data-title="amazon-smt-music-companion amazon smt music companion project">
				<h3>amazon-smt-music-companion</h3>
				<p>Amazon SMT music companion project.</p>
			</a>
			<a href="/portfolio/bulborb-net" class="project-card" data-title="bulborb-net">
				<h3>bulborb-net</h3>
				<p>Bulborb.net.</p>
			</a>
			<a href="/portfolio/chrome-dino-game" class="project-card" data-title="chrome-dino-game chrome dino game clone">
				<h3>chrome-dino-game</h3>
				<p>Chrome dino game clone.</p>
			</a>
			<a href="/portfolio/firefox-ui-tweaks" class="project-card" data-title="firefox-ui-tweaks firefox ui tweaks">
				<h3>firefox-ui-tweaks</h3>
				<p>Firefox UI tweaks.</p>
			</a>
			<a href="/portfolio/sadie-portfolio" class="project-card" data-title="sadie-portfolio sadie's portfolio">
				<h3>sadie-portfolio</h3>
				<p>Sadie's portfolio.</p>
			</a>
			<a href="/portfolio/terminal-site" class="project-card" data-title="terminal-site terminal-based website">
				<h3>terminal-site</h3>
				<p>Terminal-based website.</p>
			</a>
			<a href="/portfolio/twitter-turn-based-post-theme-plugin" class="project-card" data-title="twitter-turn-based-post-theme-plugin twitter turn-based post theme plugin">
				<h3>twitter-turn-based-post-theme-plugin</h3>
				<p>Twitter turn-based post theme plugin.</p>
			</a>
			<a href="/portfolio/virtual-ant-farm" class="project-card" data-title="virtual-ant-farm virtual ant farm simulation">
				<h3>virtual-ant-farm</h3>
				<p>Virtual ant farm simulation.</p>
			</a>
			<a href="/portfolio/map-stuff" class="project-card" data-title="map-stuff geographic data points">
				<h3>map-stuff</h3>
				<p>Geographic data points.</p>
			</a>
			<a href="/portfolio/game-of-life" class="project-card" data-title="game-of-life conway's game of life">
				<h3>game-of-life</h3>
				<p>Conway's Game of Life.</p>
			</a>
			<a href="/portfolio/lorem-ipsum" class="project-card" data-title="lorem-ipsum lorem ipsum generator">
				<h3>lorem-ipsum</h3>
				<p>Lorem ipsum generator.</p>
			</a>
		</section>

		<Footer />
		<script src="../../scripts/pages/portfolio-index.ts"></script>
	</body>
</html>
