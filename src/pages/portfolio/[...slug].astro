---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { SITE_TITLE } from '../../consts';
import '../../styles/pages/home.css';

export async function getStaticPaths() {
	const projects = await getCollection('projects');
	return projects.map((project) => ({
		params: { slug: project.id },
		props: project,
	}));
}
type Props = CollectionEntry<'projects'>;

const project = Astro.props;
const { title, description, category, tags = [], github, link } = project.data;
const { Content } = await render(project);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`${title} | ${SITE_TITLE}`} description={description} />
		<style>
			.project-detail-header {
				margin-bottom: 2.5rem;
				padding-bottom: 1.75rem;
				border-bottom: 1px solid var(--border);
			}
			.back-link {
				display: inline-block;
				margin-bottom: 1.5rem;
				color: var(--text-muted);
				font-family: var(--font-mono);
				font-size: 0.85rem;
				text-transform: uppercase;
				letter-spacing: 0.5px;
				text-decoration: none;
				transition: color 0.15s ease;
			}
			.back-link:hover {
				color: var(--accent);
			}
			.category-tag-indicator {
				display: inline-block;
				font-family: var(--font-mono);
				font-size: 0.75rem;
				text-transform: uppercase;
				letter-spacing: 1px;
				padding: 0.2rem 0.5rem;
				border: 1px solid var(--border);
				border-radius: 2px;
				margin-bottom: 0.75rem;
				color: var(--text-muted);
			}
			.category-tag-indicator.professional {
				color: var(--accent);
				border-color: var(--accent);
				background: rgba(123, 104, 238, 0.08);
			}
			.tags-list {
				display: flex;
				flex-wrap: wrap;
				gap: 0.4rem;
				margin: 1.25rem 0;
				list-style: none;
				padding: 0;
			}
			.tag-item {
				font-family: var(--font-mono);
				font-size: 0.75rem;
				background: var(--bg-subtle);
				border: 1px solid var(--border);
				padding: 0.15rem 0.45rem;
				border-radius: 2px;
				color: var(--text-secondary);
				text-transform: uppercase;
			}
			.project-links {
				display: flex;
				gap: 0.75rem;
				margin-top: 1.5rem;
				flex-wrap: wrap;
			}
			.action-btn {
				display: inline-flex;
				align-items: center;
				padding: 0.45rem 1rem;
				border: 1px solid var(--accent);
				background: transparent;
				color: var(--accent);
				font-family: var(--font-mono);
				text-decoration: none;
				font-size: 0.85rem;
				text-transform: uppercase;
				letter-spacing: 0.5px;
				border-radius: 2px;
				transition: all 0.15s ease;
			}
			.action-btn:hover {
				background: var(--accent);
				color: #000;
			}
			.action-btn.secondary {
				border-color: var(--border-light);
				color: var(--text-primary);
			}
			.action-btn.secondary:hover {
				border-color: var(--accent);
				color: var(--accent);
				background: rgba(123, 104, 238, 0.05);
			}
			.markdown-body {
				line-height: 1.75;
				color: var(--text-secondary);
			}
			.markdown-body h1 {
				display: none; /* Already rendered in header */
			}
			.markdown-body h2 {
				margin-top: 2rem;
				margin-bottom: 0.75rem;
				font-size: 1.35rem;
				border-bottom: 1px solid var(--border);
				padding-bottom: 0.4rem;
				color: var(--text-primary);
			}
			.markdown-body ul {
				padding-left: 1.5rem;
				margin-bottom: 1.5rem;
			}
			.markdown-body li {
				margin-bottom: 0.4rem;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<div class="project-detail-header">
				<a href="/" class="back-link">← All Projects</a>
				<div>
					<span class={`category-tag-indicator ${category}`}>
						[{category === 'professional' ? 'PROFESSIONAL' : 'FOR FUN'}]
					</span>
				</div>
				<h1>{title}</h1>
				<p style="color: var(--text-secondary); font-size: 1.1rem; margin-top: 0.5rem;">{description}</p>

				{tags.length > 0 && (
					<ul class="tags-list">
						{tags.map((tag) => (
							<li class="tag-item">{tag}</li>
						))}
					</ul>
				)}

				<div class="project-links">
					{github && (
						<a href={github} target="_blank" rel="noopener noreferrer" class="action-btn">
							GitHub Source ↗
						</a>
					)}
					{link && (
						<a href={link} target="_blank" rel="noopener noreferrer" class="action-btn secondary">
							Live Demo ↗
						</a>
					)}
				</div>
			</div>

			<article class="markdown-body">
				<Content />
			</article>
		</main>
		<Footer />
	</body>
</html>
